def make_edges(values, bins=70, log=False):
    values = np.asarray(values)
    if log:
        positive = values[values > 0]
        if len(positive) == 0:
            raise ValueError("Logarithmic bins require positive values.")
        return np.geomspace( positive.min(), positive.max(), bins + 1)
    return np.linspace( values.min(), values.max(), bins + 1)


def profile_min(frame, parameter, edges, log=False):
    if frame.empty:
        return np.array([]), np.array([]), np.array([])
    values = frame[parameter].to_numpy()
    scores = frame["delta_chi2"].to_numpy()
    inside = ( (values >= edges[0]) & (values <= edges[-1]))
    values = values[inside]
    scores = scores[inside]
    if len(values) == 0:
        return np.array([]), np.array([]), np.array([])

    index = np.searchsorted(
        edges,
        values,
        side="right",
    ) - 1

    index = np.clip(
        index,
        0,
        len(edges) - 2,
    )

    minimum = np.full(
        len(edges) - 1,
        np.inf,
    )

    count = np.zeros(
        len(edges) - 1,
        dtype=int,
    )

    np.minimum.at(
        minimum,
        index,
        scores,
    )

    np.add.at(
        count,
        index,
        1,
    )

    if log:
        centers = np.sqrt(
            edges[:-1] * edges[1:]
        )
    else:
        centers = 0.5 * (
            edges[:-1] + edges[1:]
        )

    good = (
        np.isfinite(minimum) &
        (count > 0)
    )

    return (
        centers[good],
        minimum[good],
        count[good],
    )


def cell_statistics(frame, xcol, ycol, xedges, yedges):
    shape = (
        len(yedges) - 1,
        len(xedges) - 1,
    )

    minimum = np.full(shape, np.inf)
    count = np.zeros(shape, dtype=int)

    if frame.empty:
        return minimum, count

    x = frame[xcol].to_numpy()
    y = frame[ycol].to_numpy()
    scores = frame["delta_chi2"].to_numpy()

    inside = (
        (x >= xedges[0]) &
        (x <= xedges[-1]) &
        (y >= yedges[0]) &
        (y <= yedges[-1])
    )

    x = x[inside]
    y = y[inside]
    scores = scores[inside]

    if len(x) == 0:
        return minimum, count

    xi = np.searchsorted(
        xedges,
        x,
        side="right",
    ) - 1

    yi = np.searchsorted(
        yedges,
        y,
        side="right",
    ) - 1

    xi = np.clip(
        xi,
        0,
        len(xedges) - 2,
    )

    yi = np.clip(
        yi,
        0,
        len(yedges) - 2,
    )

    np.minimum.at(
        minimum,
        (yi, xi),
        scores,
    )

    np.add.at(
        count,
        (yi, xi),
        1,
    )

    return minimum, count


