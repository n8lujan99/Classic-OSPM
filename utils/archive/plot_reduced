def fitted_lower_contour(frame, parameter, edges):
    """Quadratic fit to the binned lower chi-square envelope."""
    if frame.empty:
        return np.array([]), np.array([])

    values = frame[parameter].to_numpy()
    scores = frame["chi2"].to_numpy()

    inside = (
        (values >= edges[0]) &
        (values <= edges[-1]) &
        np.isfinite(values) &
        np.isfinite(scores)
    )

    values = values[inside]
    scores = scores[inside]

    if len(values) < 3:
        return np.array([]), np.array([])

    index = np.searchsorted(edges, values, side="right") - 1
    index = np.clip(index, 0, len(edges) - 2)

    minimum = np.full(len(edges) - 1, np.inf)
    np.minimum.at(minimum, index, scores)

    centers = 0.5 * (edges[:-1] + edges[1:])
    good = np.isfinite(minimum)

    x_profile = centers[good]
    y_profile = minimum[good]

    # Keep the fit tied to the visible lower contour instead of high-chi2
    # outliers. Scaling x avoids numerical trouble for black-hole mass.
    near_floor = y_profile <= min(chi2_plot_max, chi_min + 60.0)
    x_profile = x_profile[near_floor]
    y_profile = y_profile[near_floor]

    if len(x_profile) < 3:
        return x_profile, y_profile

    x_mid = 0.5 * (edges[0] + edges[-1])
    x_half_range = 0.5 * (edges[-1] - edges[0])
    x_scaled = (x_profile - x_mid) / x_half_range

    coefficients = np.polyfit(x_scaled, y_profile, deg=2)

    x_fit = np.linspace(edges[0], edges[-1], 400)
    x_fit_scaled = (x_fit - x_mid) / x_half_range
    y_fit = np.polyval(coefficients, x_fit_scaled)

    return x_fit, y_fit

